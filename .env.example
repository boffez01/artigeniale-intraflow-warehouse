GEMINI_API_KEY=
# Modello configurabile: cambialo qui senza toccare il codice
GEMINI_MODEL=gemini-3.8-flash
DATA_DIR=./data
PORT=3000
# Watcher: true se la cartella inbox è una condivisione di rete (SMB/NFS)
WATCH_POLLING=false
# Il file deve restare invariato per questo tempo prima di essere letto
WATCH_STABILITY_MS=3000
# dryrun = scrive un JSON in data/outbox | api = chiama Giobby (da implementare)
GIOBBY_MODE=dryrun
GIOBBY_BASE_URL=
GIOBBY_TOKEN=
